---
// 检索框：有释文的页面里就地过滤本页，其余页面过滤侧栏目录。
import Icon from './Icon.astro';

interface Props {
  placeholder: string;
}
const { placeholder } = Astro.props;
---

<label class="sb-search"
  ><Icon name="search" /><input id="q" type="search" placeholder={placeholder} aria-label={placeholder} autocomplete="off" /></label
>
<div class="hint" id="hits"></div>
