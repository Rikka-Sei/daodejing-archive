---
// 侧栏的一行：图标 + 文字，选中时灰底。
import type { IconName } from '../lib/icons';
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
  icon: IconName;
  on?: boolean;
  attrs?: Record<string, string>;
}
const { href, label, icon, on = false, attrs = {} } = Astro.props;
---

<a class:list={['item', { on }]} href={href} {...attrs}><Icon name={icon} /><span class="t">{label}</span></a>
