---
// 文献目录：有几个本的文献是文件夹，各本列在里面；只有一个本的直接是一项。
// current 是当前本的 id。
import type { Group } from '../lib/corpus';
import Icon from './Icon.astro';
import Leaf from './Leaf.astro';
import MoreButton from './MoreButton.astro';
import RowMenu from './RowMenu.astro';

interface Props {
  corpusId: string;
  groups: Group[];
  current?: string;
}
const { corpusId, groups, current = '' } = Astro.props;
---

<div class="tree">
  {
    groups.map((g) =>
      g.single ? (
        <Leaf corpusId={corpusId} group={g} wit={g.first} current={current} top={true} />
      ) : (
        <details class="dir" data-g={g.id} open>
          <summary class="item">
            <Icon name="folder" class="f-shut" />
            <Icon name="folder-open" class="f-open" />
            <span class="t">{g.name}</span>
            <MoreButton label={g.name} />
            <RowMenu corpusId={corpusId} stem={`${g.id}-all`} name={g.name} whole={true} />
          </summary>
          <div class="kids">
            {g.witnesses.map((w) => (
              <Leaf corpusId={corpusId} group={g} wit={w} current={current} top={false} />
            ))}
          </div>
        </details>
      ),
    )
  }
</div>
