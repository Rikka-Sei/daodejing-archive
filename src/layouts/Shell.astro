---
// 页面外壳：侧栏、顶栏（面包屑与开关）、正文栏。插槽 side / crumb 与默认插槽（正文）。
import '../styles/site.css';
import alignUrl from '../scripts/align.js?url';
import appUrl from '../scripts/app.js?url';
import layoutUrl from '../scripts/layout.js?url';
import readerUrl from '../scripts/reader.js?url';
import Icon from '../components/Icon.astro';
import Tools from '../components/Tools.astro';
import { facesCss, preloadHrefs } from '../lib/fonts';
import { FAVICON } from '../lib/icons';

interface Props {
  title: string;
  desc: string;
  /** 页面里有释文，竖排时正文栏撑满整宽 */
  wide?: boolean;
  /** 顶栏的开关：theme 只放外观；text 加上释文排版与影像；reader 是阅读器的一组 */
  tools?: 'theme' | 'text' | 'reader';
  /** 侧栏打开时停在哪条轴：m 材料，c 章节 */
  axis?: 'm' | 'c';
  /** 这个页面用的脚本：align 是对读页的列高亮，reader 是阅读器的透视，layout 是透视页的选章 */
  script?: 'align' | 'reader' | 'layout';
}
const { title, desc, wide = false, tools = 'text', axis = 'm', script } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href={FAVICON} />
    {preloadHrefs().map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={facesCss()}></style>
  </head>
  <body class:list={[{ rdr: script === 'reader' }]}>
    <div id="app">
      <aside id="side" data-axis={axis}><slot name="side" /></aside>
      <main>
        <header class="top">
          <button type="button" class="ibtn" id="menu" aria-label="菜单"><Icon name="menu" /></button>
          <span class="tile"><Icon name="book" /></span>
          <nav class="crumb"><slot name="crumb" /></nav>
          <div class="tools"><Tools mode={tools} /></div>
        </header>
        <div class:list={['content', { wide, reader: script === 'reader' }]}><slot /></div>
      </main>
    </div>
    <div id="pop" class="pop" role="menu" hidden></div>
    <script is:inline src={appUrl}></script>
    {script === 'align' && <script is:inline src={alignUrl}></script>}
    {script === 'reader' && <script is:inline src={readerUrl}></script>}
    {script === 'layout' && <script is:inline src={layoutUrl}></script>}
  </body>
</html>
