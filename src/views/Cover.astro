---
// 阅读版封面：标题、文献卡片、凡例。
import DocCard from '../components/DocCard.astro';
import ReadSide from '../components/ReadSide.astro';
import Shell from '../layouts/Shell.astro';
import type { Corpus } from '../lib/corpus';
import { prefaceItems } from '../lib/preface';
import { dataUrl, REPO_URL, witnessUrl } from '../lib/url';

interface Props {
  corpus: Corpus;
  corpora: Corpus[];
}
const { corpus: c, corpora } = Astro.props;
const [nUnits, nPlates] = c.totals;
const stats = [`${c.witnesses.length} 个版本`, `${nUnits} 条释文`, ...(nPlates ? [`${nPlates} 张影像`] : [])];
---

<Shell title={c.title} desc={`${c.subtitle}。${c.intro}`} themeOnly>
  <ReadSide slot="side" corpus={c} corpora={corpora} onCover />
  <b slot="crumb">{c.title}</b>
  <div class="hero">
    <div class="eyebrow">{c.subtitle}</div>
    <h1>{c.title}</h1>
    <p class="sub">{c.intro}</p>
    <div class="actions">
      <a class="btn pri" href={witnessUrl(c, c.witnesses[0])}>开始阅读</a>
      <a class="btn" href={dataUrl(c)}>数据版</a>
    </div>
    <div class="stats">{stats.join(' · ')}</div>
  </div>
  <div class="docs">{c.groups.map((g) => <DocCard corpus={c} group={g} />)}</div>
  <section id="preface" class="sec">
    <h2>凡例</h2>
    <ol class="preface">{prefaceItems(c).map((t) => <li>{t}</li>)}</ol>
  </section>
  <div class="foot"><a href={REPO_URL}>原始数据在 GitHub</a></div>
</Shell>
