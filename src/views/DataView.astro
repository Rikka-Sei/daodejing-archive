---
// 数据版：所有版本在一页里，按版本切换（#<本 id>），可跨版本检索；各版本的段落默认隐藏，由 app.js 显示。
import DataSide from '../components/DataSide.astro';
import FactsFold from '../components/FactsFold.astro';
import Gallery from '../components/Gallery.astro';
import Icon from '../components/Icon.astro';
import SourcesFold from '../components/SourcesFold.astro';
import Unit from '../components/Unit.astro';
import Shell from '../layouts/Shell.astro';
import type { Corpus } from '../lib/corpus';
import { esc } from '../lib/html';
import { LEGEND } from '../lib/legend';
import { colophon, UNIT_WORD } from '../lib/text';
import { coverUrl, REPO_URL } from '../lib/url';

interface Props {
  corpus: Corpus;
  corpora: Corpus[];
}
const { corpus: c, corpora } = Astro.props;
// 面包屑的初始内容；脚本切换版本时先还原成它，再追加当前版本名
const baseCrumb = `<a href="${esc(coverUrl(c))}">${esc(c.title)}</a><span class="sep">›</span><span>数据版</span>`;
---

<Shell
  title={`${c.title} · 数据版`}
  desc={`${c.title}的全部版本，数据版`}
  wide
  crumbId="crumb"
  crumbBase={baseCrumb}
>
  <DataSide slot="side" corpus={c} corpora={corpora} />
  <Fragment slot="crumb" set:html={baseCrumb} />
  <section id="overview">
    <h1>{c.title}　数据版</h1>
    <p class="lead">{c.subtitle}。所有版本在同一页，可按版本切换，检索会统计各版本的命中数。</p>
    <div class="rows">
      {
        c.witnesses.map((w) => (
          <a class="row" href={`#${w.id}`}>
            <span class="bd">
              <span class="t">{w.title}</span>
              <span class="m" title={colophon(w.meta)}>
                {w.units.length} {UNIT_WORD[w.units[0].unit_type]} · {w.plates.length} 张影像 · {colophon(w.meta)}
              </span>
            </span>
            <Icon name="chev" />
          </a>
        ))
      }
    </div>
  </section>
  {
    c.witnesses.map((w) => (
      <section class="wit" id={`w-${w.id}`} hidden>
        <h1>{w.meta.name}</h1>
        <FactsFold wit={w} />
        <SourcesFold corpus={c} wit={w} />
        <div class="legend">{LEGEND}</div>
        <div class="units">{w.units.map((u) => <Unit unit={u} wit={w} corpusId={c.id} />)}</div>
        <Gallery wit={w} corpusId={c.id} />
      </section>
    ))
  }
  <div class="foot">
    共 {c.witnesses.length} 个版本，{c.totals[0]} 条释文，{c.totals[1]} 张影像 · <a href={REPO_URL}>原始数据在 GitHub</a>
  </div>
</Shell>
